# .env unificado para app_unificada.
# Copia este archivo a ".env" en la raíz y completa los valores.
#
# NOTA: algunas sub-apps cargan su .env buscando explícitamente en su propia
# carpeta (hoja-ruta, observatorio-espectro, vigilancia-tecnologica,
# formulario-banda-900). Para esas, copia también este archivo (con los
# valores ya completos) dentro de la carpeta de la sub-app como ".env" hasta
# que se centralice la carga de configuración.

# --- Gemini (analisis-comentarios, chatbot-pqrs, hoja-ruta, vigilancia-tecnologica) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=65536

# --- OpenAI opcional (vigilancia-tecnologica) ---
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- vigilancia-tecnologica ---
DATA_DIR=../Vigilanciatecnologica_data
OUTPUT_DIR=outputs
DASHBOARD_DATA_SOURCE=auto

# --- observatorio-espectro ---
DATABASE_PATH=data/demo_observatorio.db
REQUEST_TIMEOUT_SECONDS=90

# --- Supabase (compartido: vigilancia-tecnologica, formulario-banda-900) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=source-documents

# --- formulario-banda-900 ---
DATABASE_URL=
